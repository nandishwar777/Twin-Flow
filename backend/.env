# EASY MODE (default): leave DATABASE_URL blank or commented out.
# The app will create a local SQLite file (backend/twinflow.db) automatically.
# No PostgreSQL or password required.

DATABASE_URL=postgresql://postgres:twinflow123@localhost:5432/twinflow

# OPTIONAL — only if you want to use PostgreSQL instead:
# If your password contains @ : / # ? % or space, you MUST URL-encode them
# (@ becomes %40, : becomes %3A, etc.)
# Example with password "abc@9739":
# DATABASE_URL=postgresql://postgres:abc%409739@localhost:5432/twinflow

SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
HOST=0.0.0.0
PORT=8080

# ================================================================
#  EMAIL NOTIFICATIONS  (Gmail SMTP)
# ================================================================
# If you don't fill these in, emails are skipped (printed to console only).
#
# For Gmail:
#   1. Enable 2-Step Verification on your Google account.
#   2. Visit https://myaccount.google.com/apppasswords and generate an "App password".
#   3. Use that 16-character app password below (NOT your normal Gmail password).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nandishwark99@gmail.com
SMTP_PASSWORD=nskb kdtq ziyr gtei
SMTP_FROM=nandishwark99@gmail.com
SMTP_TLS=true

# ================================================================
#  SMS NOTIFICATIONS  (Fast2SMS — Indian SMS gateway)
# ================================================================
# Sign up FREE at https://www.fast2sms.com/  (gives free trial SMS).
#
# Steps:
#   1. Register with your mobile number (no card needed for trial).
#   2. Go to "Dev API" section → copy your API key.
#   3. Paste it below.
#   4. Restart the app — SMS reminders & OTP now work.
#
# If left blank, SMS is skipped (logged to console). The app still works
# perfectly with email-only notifications.

FAST2SMS_API_KEY=TVsQENxp8IK5RFJaGljykSf0PbmMH1d93YZiWwD6BC7cqOvo2USvYQmJwaFIgZWHnGXtyfEM5Tz37r4e
FAST2SMS_SENDER_ID=TWNFLW
# Route 'q' = quick transactional (works on free trial). 'dlt' for promotional.
FAST2SMS_ROUTE=q

# ================================================================
#  PASSWORD-RESET OTP
# ================================================================
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ================================================================
#  SCHEDULER  (when automated jobs run, 24-hour clock, server's timezone)
# ================================================================

# Public URL of your app (used inside email links)
APP_URL=http://localhost:8080

# Daily habit reminder — every day at this time
DAILY_REMINDER_HOUR=8
DAILY_REMINDER_MINUTE=0

# Weekly report — every week on this day at this hour
WEEKLY_REPORT_DAY=sun
WEEKLY_REPORT_HOUR=18

# Reliability: every N hours, check for any user overdue (>=7 days) for
# their weekly report and send it. Guarantees reports never get missed
# even if the app was offline on Sunday 6 PM.
WEEKLY_CATCHUP_INTERVAL_HOURS=6

TZ=Asia/Kolkata

